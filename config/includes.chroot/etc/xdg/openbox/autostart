# Se ejecuta al iniciar la sesion de Openbox.

# El equipo se administra a distancia: que la pantalla no se apague ni se bloquee.
xset s off
xset -dpms
xset s noblank

tint2 &
nm-applet &

# Icono de RustDesk (el servicio ya corre desde el arranque; esto solo muestra la ventana/bandeja).
(sleep 3; rustdesk --tray) &
