# Barra inferior de LiteDesk: lanzadores | ventanas abiertas | bandeja (wifi, etc.) | reloj

# --- Fondos (el numero es el orden de aparicion) ---
# ID 1: barra
rounded = 0
border_width = 0
background_color = #1b2430 100
border_color = #000000 0

# ID 2: ventana normal
rounded = 4
border_width = 0
background_color = #ffffff 12
border_color = #ffffff 0
background_color_hover = #ffffff 25
border_color_hover = #ffffff 0

# ID 3: ventana activa
rounded = 4
border_width = 0
background_color = #ffffff 30
border_color = #ffffff 0

# --- Barra ---
panel_items = LTSC
panel_size = 100% 38
panel_position = bottom center horizontal
panel_margin = 0 0
panel_padding = 6 3 6
panel_background_id = 1
panel_layer = top
panel_monitor = all
autohide = 0
strut_policy = follow_size
wm_menu = 1
panel_dock = 0

# --- Lanzadores (los que no existan se ignoran) ---
launcher_padding = 2 2 8
launcher_background_id = 0
launcher_icon_size = 26
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/firefox-esr.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/lxterminal.desktop
launcher_item_app = /usr/share/applications/litedesk-deb.desktop
launcher_item_app = /usr/share/applications/rustdesk.desktop

# --- Ventanas abiertas ---
taskbar_mode = single_desktop
taskbar_padding = 2 2 2
taskbar_background_id = 0
task_text = 1
task_icon = 1
task_maximum_size = 180 32
task_padding = 6 3 6
task_background_id = 2
task_active_background_id = 3
task_font_color = #ffffff 85
task_active_font_color = #ffffff 100

# --- Bandeja del sistema: aca aparece el icono de wifi ---
systray_padding = 4 2 4
systray_background_id = 0
systray_icon_size = 22

# --- Reloj ---
time1_format = %H:%M
time1_font = Sans 10
clock_font_color = #ffffff 100
clock_padding = 8 0
clock_background_id = 0
