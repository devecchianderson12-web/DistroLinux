#!/usr/bin/env python3
"""Instalador de paquetes .deb de LiteDesk.

Sin argumentos abre un selector de archivos; con argumentos (doble clic sobre un .deb)
instala esos archivos. La instalacion corre en una terminal con `apt`, que resuelve las
dependencias, muestra que se va a instalar y pide confirmacion.
"""
import os
import shlex
import shutil
import subprocess
import sys


def elegir_archivos():
    import tkinter as tk
    from tkinter import filedialog

    raiz = tk.Tk()
    raiz.withdraw()
    inicio = os.path.expanduser("~")
    for carpeta in ("Descargas", "Downloads"):
        ruta = os.path.join(inicio, carpeta)
        if os.path.isdir(ruta):
            inicio = ruta
            break
    archivos = filedialog.askopenfilenames(
        parent=raiz,
        title="Elegi uno o mas paquetes .deb",
        initialdir=inicio,
        filetypes=[("Paquetes Debian", "*.deb"), ("Todos los archivos", "*")],
    )
    raiz.destroy()
    return list(archivos)


def guion(archivos):
    """Comando de shell que se ejecuta dentro de la terminal."""
    lista = " ".join(shlex.quote(os.path.abspath(a)) for a in archivos)
    return (
        "echo 'Paquetes a instalar:'; "
        + "".join("echo ' - '%s; " % shlex.quote(os.path.basename(a)) for a in archivos)
        + "echo; sudo apt install %s; estado=$?; echo; " % lista
        + "if [ $estado -eq 0 ]; then echo 'Listo: instalacion terminada.'; "
        + "else echo \"La instalacion no se completo (codigo $estado).\"; fi; "
        + "printf 'Presiona Enter para cerrar...'; read _"
    )


def main(argv, elegir=elegir_archivos, ejecutar=subprocess.call):
    archivos = [a for a in argv if a.lower().endswith(".deb")] or (
        [] if argv else [a for a in elegir() if a.lower().endswith(".deb")]
    )
    if not archivos:
        return 0
    terminal = shutil.which("lxterminal")
    if terminal:
        cmd = [terminal, "-t", "Instalar paquete .deb", "-e", "sh", "-c", guion(archivos)]
    else:
        cmd = ["x-terminal-emulator", "-e", "sh", "-c", guion(archivos)]
    return ejecutar(cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
